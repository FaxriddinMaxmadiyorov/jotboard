<header class="topbar">
  <%= link_to root_path, class: "brand" do %><%= render "shared/logo" %><% end %>
  <div class="topbar__me">
    <%= avatar current_visitor.nickname, current_visitor.color, size: 30 %>
    <span class="topbar__name"><%= current_visitor.nickname %></span>
    <%= link_to "Change name", new_session_path(return_to: request.fullpath), class: "link-muted" %>
  </div>
</header>
